{
  "name": "playwright-tests",
  "version": "1.0.0",
  "description": "End-to-end tests written with Playwright and TypeScript",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "husky",
    "install:deps": "npm ci",
    "deps:playwright": "npx playwright install --with-deps chromium",
    "setup:env": "node -e \"require('fs').copyFileSync('.env.example', '.env', require('fs').constants.COPYFILE_EXCL)\"",
    "format": "npx prettier --write .",
    "format:check": "npx prettier . --check \"!**.ts\"",
    "lint": "npx eslint . --max-warnings 0",
    "test:headless": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:ui": "npx playwright test --ui",
    "test:e2e": "npx playwright test --project=chromium",
    "test:api": "npx playwright test --project=api",
    "test:report": "npx playwright show-report",
    "allure:generate": "npx allure generate allure-results",
    "allure:open": "npx allure open allure-report",
    "tsc:check": "npx tsc --noEmit --pretty"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "~24.19.2",
    "allure": "3.20.1",
    "allure-playwright": "^3.13.0",
    "dotenv": "~17.4.2",
    "eslint": "~10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "~17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.71.2"
  }
}
